{
  "name": "tiny-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox add-on that reads web page text aloud with tiny-voca, fully offline",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "fetch-assets": "tsx scripts/fetch-assets.ts",
    "build-espeak": "bash scripts/build-espeak.sh",
    "german-fixtures": "bash scripts/german-fixtures.sh",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run --exclude \"tests/**\"",
    "lint:ext": "web-ext lint --source-dir .output/firefox-mv3",
    "postinstall": "wxt prepare",
    "test:parity": "vitest run tests/parity",
    "test:smoke": "vitest run tests/smoke",
    "test:e2e": "vitest run tests/e2e",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "jsdom": "31.0.1",
    "lefthook": "2.2.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1",
    "pdfjs-dist": "6.5.438"
  }
}
